# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# local database overrides (port etc.) — covered by .env* above, listed
# explicitly so it is obvious this must never be committed
.env.db.local

# local development database: downloaded PostgreSQL binaries, the cluster data
# directory, and the server log. Never commit binaries or database contents.
# Glob covers alternate PANTHER_DB_HOME locations such as .localdb-alt/.
/.localdb*/

# test artifacts
/test-results/
/playwright-report/
/blob-report/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
