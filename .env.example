# Copy to .env.local and fill in values. Never commit real credentials.

# --- Supabase ---
# Public: safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server-only. Bypasses RLS. Must never get a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- SMS (provider-independent; set one provider in Ticket 5) ---
# "telnyx" or "twilio"
SMS_PROVIDER=
# E.164 sending number shared by either provider
SMS_FROM_NUMBER=
# Telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- App ---
# Base URL used when generating signup/staff links, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=
