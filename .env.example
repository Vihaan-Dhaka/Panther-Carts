# Copy to .env.local and fill in values. Never commit real credentials.

# --- Supabase ---
# Public: safe for the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server-only. Bypasses RLS. Must never get a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Authentication (server-only) ---
# 32+ random characters used to derive credential encryption/HMAC keys.
PANTHER_AUTH_SECRET=
# Stable base64 key shared by every Next.js instance for Server Actions.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- SMS (server-only; configure credentials only for the selected provider) ---
# "telnyx" or "twilio"
SMS_PROVIDER=
# Local 10DLC sender in E.164 format. Do not use toll-free for this flow.
SMS_FROM_NUMBER=
# Bearer secret for POST /api/internal/sms-outbox (32+ characters)
SMS_OUTBOX_WORKER_SECRET=
# Telnyx
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Exact public URL configured in Twilio, including path/query string.
TWILIO_WEBHOOK_URL=

# --- App ---
# Base URL used when generating signup/staff links, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=
